            {"type": "cloze", "de": "___ wohnst du? – In Berlin.", "tr": "Nerede oturuyorsun? – Berlin'de.", "answers": ["Wo"], "options": ["Wo", "Woher", "Wann"], "explain_tr": "Cevap bir yer (in Berlin) → wo. woher = nereden."},
            {"type": "order", "tr": "Nerelisin?", "tokens": ["Woher", "kommst", "du"], "answers": ["Woher kommst du"], "explain_tr": "Soru kelimesi + fiil + özne."},

          "steps": [
            {"type": "intro", "lexemes": ["hallo", "guten_morgen", "guten_tag", "guten_abend"], "note_tr": "Dinle, tekrar et. Beğendiğin ifadeyi kelime defterine kaydedebilirsin."},
            {"type": "intro", "lexemes": ["tschuess", "auf_wiedersehen", "danke", "bitte"]},
            {"type": "dialogue", "title_tr": "Fırında, sabah 8", "lines": [
              {"speaker": "Verkäuferin", "de": "Guten Morgen!", "tr": "Günaydın!"},
              {"speaker": "Du", "de": "Guten Morgen! Zwei Brötchen, bitte.", "tr": "Günaydın! İki ekmek, lütfen."},
              {"speaker": "Verkäuferin", "de": "Bitte schön. Das macht einen Euro.", "tr": "Buyurun. Bir avro ediyor."},
              {"speaker": "Du", "de": "Danke! Auf Wiedersehen!", "tr": "Teşekkürler! Hoşça kalın!"}
            ]},
            {"type": "choice", "prompt_tr": "Saat 19:00. Komşunla merdivende karşılaşıyorsun. Ne dersin?", "options": ["Guten Morgen!", "Guten Abend!", "Tschüss!"], "answers": [1], "explain_tr": "Akşam karşılaşırken \"Guten Abend\" denir. \"Tschüss\" vedalaşmak içindir."},
            {"type": "choice", "prompt_tr": "Bürgeramt'tan çıkıyorsun. Memura nasıl veda edersin?", "options": ["Tschüss!", "Auf Wiedersehen!", "Hallo!"], "answers": [1], "explain_tr": "Resmî ortamda \"Auf Wiedersehen\" uygundur. \"Tschüss\" samimidir; birçok yerde duyulur ama resmî yerde \"Auf Wiedersehen\" daha güvenli."},
            {"type": "choice", "prompt_tr": "Biri sana \"Danke!\" dedi. En doğal cevap hangisi?", "options": ["Bitte!", "Danke!", "Hallo!"], "answers": [0], "explain_tr": "\"Bitte\" burada \"rica ederim\" anlamındadır. \"Gern geschehen\" da denebilir."},
            {"type": "cloze", "de": "Guten ___! (sabah)", "tr": "Günaydın!", "answers": ["Morgen"], "options": ["Morgen", "Abend", "Tag"], "explain_tr": "Sabah: Guten Morgen. Gün içinde: Guten Tag. Akşam: Guten Abend."},
            {"type": "translate", "tr": "Teşekkürler, hoşça kalın!", "answers": ["Danke, auf Wiedersehen!", "Vielen Dank, auf Wiedersehen!", "Danke schön, auf Wiedersehen!", "Danke und auf Wiedersehen!"], "hint_tr": "Teşekkür: danke · Resmî veda: auf Wiedersehen"}
          ]
        },
        {
          "id": "u1l2", "title_tr": "Kendini tanıt", "objective_tr": "Adını, nereli olduğunu ve nerede oturduğunu söyle.", "minutes": 7,
          "vocab": ["heissen", "kommen", "wohnen", "ich_komme_aus", "freut_mich", "wie", "woher", "sein"],
          "steps": [
            {"type": "intro", "lexemes": ["heissen", "kommen", "wohnen", "freut_mich"]},
            {"type": "grammar", "concept": "g_sein_pronomen"},
            {"type": "dialogue", "title_tr": "Yeni ev arkadaşı", "lines": [
              {"speaker": "Lina", "de": "Hallo! Ich bin Lina. Wie heißt du?", "tr": "Merhaba! Ben Lina. Senin adın ne?"},
              {"speaker": "Du", "de": "Ich heiße Deniz. Freut mich!", "tr": "Benim adım Deniz. Memnun oldum!"},
              {"speaker": "Lina", "de": "Woher kommst du, Deniz?", "tr": "Nerelisin, Deniz?"},
              {"speaker": "Du", "de": "Ich komme aus der Türkei, aus Izmir.", "tr": "Türkiye'denim, İzmirliyim."}
            ]},
            {"type": "cloze", "de": "Ich ___ Deniz.", "tr": "Benim adım Deniz.", "answers": ["heiße", "bin"], "options": ["heiße", "heißt", "heißen"], "explain_tr": "ich ile fiil -e alır: ich heiße. \"Ich bin Deniz\" de doğrudur."},
            {"type": "cloze", "de": "Woher ___ du?", "tr": "Nerelisin?", "answers": ["kommst"], "options": ["komme", "kommst", "kommt"], "explain_tr": "du ile ek -st: du kommst."},
            {"type": "choice", "prompt_tr": "\"Ich komme aus der Türkei\" ne demek?", "options": ["Türkiye'ye gidiyorum.", "Türkiye'denim.", "Türkiye'de oturuyorum."], "answers": [1], "explain_tr": "aus = -den. \"kommen aus\" kökeni anlatır. \"in der Türkei wohnen\" = Türkiye'de oturmak."},
            {"type": "choice", "prompt_tr": "Yaşlı komşuna adını soruyorsun. Hangisi uygun?", "options": ["Wie heißt du?", "Wie heißen Sie?", "Wer bist du?"], "answers": [1], "explain_tr": "Tanımadığın bir yetişkine \"Sie\" ile hitap edilir: Wie heißen Sie?"},
            {"type": "order", "tr": "Berlin'de oturuyorum.", "tokens": ["Ich", "wohne", "in", "Berlin"], "answers": ["Ich wohne in Berlin", "In Berlin wohne ich"], "explain_tr": "Fiil (wohne) ikinci sırada."},
            {"type": "order", "tr": "Türkiye'denim.", "tokens": ["Ich", "komme", "aus", "der", "Türkei"], "answers": ["Ich komme aus der Türkei", "Aus der Türkei komme ich"]},
            {"type": "translate", "tr": "Benim adım Can. Memnun oldum!", "answers": ["Ich heiße Can. Freut mich!", "Mein Name ist Can. Freut mich!", "Ich bin Can. Freut mich!", "Ich heiße Can, freut mich!", "Ich bin Can, freut mich!", "Mein Name ist Can, freut mich!"], "hint_tr": "adı … olmak: heißen", "explain_tr": "Üç yol da doğru: Ich heiße …, Ich bin …, Mein Name ist … (biraz daha resmî)."}
          ]
        }
      ]
    },

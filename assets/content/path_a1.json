            {"type": "choice", "prompt_tr": "Hangi cümle doğru?", "options": ["Wo du wohnst?", "Wo wohnst du?", "Du wo wohnst?"], "answers": [1], "explain_tr": "Soru kelimesinden hemen sonra çekimli fiil gelir."},
            {"type": "translate", "tr": "Kaç yaşındasın?", "answers": ["Wie alt bist du?"], "hint_tr": "Almancada \"ne kadar yaşlısın?\" diye sorulur: wie alt"}

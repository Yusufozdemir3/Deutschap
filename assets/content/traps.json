              "tr": "masa, lamba, yatak"
            }
          ]
        },
        {
          "type": "article",
          "lexeme": "tisch"
        },
        {
          "type": "article",
          "lexeme": "lampe"
        },
        {
          "type": "article",
          "lexeme": "bett"
        },
        {
          "type": "choice",
          "prompt_tr": "Kelimeyi nasıl öğrenmelisin?",
          "options": [
            "der Schlüssel – anahtar",
            "Schlüssel – anahtar"
